      "outputs": ["accuracy_row"],
      "acceptance": "2 rows; schema (family,noise,accuracy)"
    },
    {
      "id": "boosting",
      "capability": "ml_ensemble",
      "depends_on": [],
      "inputs": ["task.prompt"],
      "outputs": ["accuracy_row"],
      "acceptance": "2 rows; schema (family,noise,accuracy)"
    },
    {
      "id": "stacking",
      "capability": "ml_ensemble",
      "depends_on": [],
      "inputs": ["task.prompt"],
      "outputs": ["accuracy_row"],
      "acceptance": "2 rows; schema (family,noise,accuracy)"
    }
  ],
  "worker_pool": [
    {"id": "bag_agent", "capabilities": ["ml_ensemble"]},
    {"id": "boost_agent", "capabilities": ["ml_ensemble"]},
    {"id": "stack_agent", "capabilities": ["ml_ensemble"]}
  ],
  "aggregate": {
