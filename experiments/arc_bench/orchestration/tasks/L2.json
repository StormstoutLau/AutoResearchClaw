{
  "schema": "arc-orchestration-task/1",
  "id": "L2",
  "class": "L",
  "title": "Ensemble families under label noise",
  "source_manifest": "experiments/arc_bench/config/ml/manifests/ML02.yaml",
  "version": 1,
  "prompt": "Benchmark bagging, boosting and stacking under two noise levels. Each model family must be evaluated by a separate owner, and the report must list accuracy per family and noise level.",
  "delegation_style": "distinct_roles",
  "subgoals": [
    {
