  "version": 1,
  "prompt": "Scan the production cross-section across the available energy points for two channels, compare with the theory baseline, and probe the highest-energy point. Record infeasible points explicitly instead of imputing values.",
  "delegation_style": "capability",
  "subgoals": [
    {
      "id": "channel_a",
      "capability": "hep_scan",
      "depends_on": [],
      "inputs": ["task.prompt"],
      "outputs": ["cross_section_rows"],
      "acceptance": "4 rows; schema (subgoal,energy_gev,cross_section_pb)"
    },
    {
      "id": "channel_b",
      "capability": "hep_scan",
      "depends_on": [],
      "inputs": ["task.prompt"],
      "outputs": ["cross_section_rows"],
      "acceptance": "4 rows; schema (subgoal,energy_gev,cross_section_pb)"
    },
    {
      "id": "theory",
      "capability": "hep_scan",
      "depends_on": [],
      "inputs": ["task.prompt"],
      "outputs": ["cross_section_rows"],
      "acceptance": "4 rows; schema (subgoal,energy_gev,cross_section_pb)"
    },
    {
      "id": "high_energy_probe",
      "capability": "hep_scan",
      "depends_on": [],
      "inputs": ["task.prompt"],
      "outputs": ["probe_status"],
      "acceptance": "probe result or explicit infeasible marker"
    }
  ],
  "worker_pool": [
    {"id": "hep_scanner", "capabilities": ["hep_scan"]}
  ],
  "aggregate": {
