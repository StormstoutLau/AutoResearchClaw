{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arc:contracts:v1:claim_record",
  "title": "ClaimRecord v1",
  "description": "Mechanized academic claim. `status` may only be produced by the verdict kernel; lowercase values match AP CitationLabel plus `speculation`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_class",
    "claim_type",
    "statement",
    "formal_statement",
    "formality",
    "assumptions",
    "evidence",
    "reasoning_chain",
    "stats_protocol",
    "falsifier",
    "verification_depth",
    "status",
    "policy_version"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^c-[0-9a-f]{8}$"},
    "claim_class": {"enum": ["A", "B", "C"]},
    "claim_type": {"enum": ["exploratory", "confirmatory"]},
    "statement": {"type": "string", "minLength": 1},
    "formal_statement": {"type": ["string", "null"]},
    "formality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["formal", "debt"]},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "debt"}}, "required": ["status"]},
          "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "why"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "urn:arc:contracts:v1:evidence_ref"}
    },
    "reasoning_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "detail", "source_refs"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "detail": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "stats_protocol": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["estimator", "sample", "missing_policy", "alpha", "section_index"],
      "properties": {
        "estimator": {"type": "string", "minLength": 1},
        "sample": {"type": "string", "minLength": 1},
        "missing_policy": {"type": "string", "minLength": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "section_index": {"type": "integer", "minimum": 1}
      }
    },
    "results": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["section_index", "value"],
      "properties": {
        "section_index": {"type": "integer", "minimum": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "falsifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "test_ref"],
      "properties": {
        "condition": {"type": "string"},
        "test_ref": {"type": "string"}
      }
    },
    "consensus": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["models", "agreement", "used_as"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "used_as": {"const": "filter"}
      }
    },
    "verification_depth": {"enum": ["stage1", "stage2", "stage3", "stage3_5"]},
    "status": {
      "enum": [
        "formally_verified",
        "partially_formalized",
        "numerically_verified",
        "latex_verified",
        "falsified",
        "failed",
        "speculation"
      ]
    },
    "policy_version": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"const": "confirmatory"}}, "required": ["claim_type"]},
      "then": {"properties": {"stats_protocol": {"type": "object"}}}
    }
  ]
}
