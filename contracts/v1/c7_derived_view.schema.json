{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arc:contracts:v1:derived_view",
  "title": "DerivedView v1",
  "description": "Read-only view generated from a source of truth; `check_cmd` must detect hand edits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_of_truth", "generated_by", "check_cmd"],
  "properties": {
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "generated_by": {"type": "string", "minLength": 1},
    "check_cmd": {"type": "string", "minLength": 1}
  }
}
