{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arc:contracts:v1:task_contract",
  "title": "TaskContract v1",
  "description": "Dispatch-time task contract: criteria and golden reference are frozen before execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "task_desc", "accept", "golden", "evidence_budget", "sensitivity", "readonly"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "task_desc": {"type": "string", "minLength": 1},
    "accept": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criteria", "criteria_hash"],
        "properties": {
          "criteria": {"type": "string", "minLength": 1},
          "criteria_hash": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "checksum"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "checksum": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence_budget": {"type": "integer", "minimum": 0},
    "sensitivity": {"enum": ["public", "internal", "private"]},
    "readonly": {"type": "boolean"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
